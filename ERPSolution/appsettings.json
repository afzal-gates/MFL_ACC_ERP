{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ConnectionString": "Data Source=YOUR_ORACLE_SERVER;User Id=YOUR_USERNAME;Password=YOUR_PASSWORD;",
    "DefaultConnection": "Data Source=YOUR_ORACLE_SERVER;User Id=YOUR_USERNAME;Password=YOUR_PASSWORD;",
    "HangfireConnection": "Server=YOUR_SQL_SERVER;Database=HangfireDB;Integrated Security=true;"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatMustBeAtLeast32CharactersLongForHS256Algorithm!",
    "Issuer": "https://localhost:5001",
    "Audience": "https://localhost:5001",
    "TokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  }
}
