<div class="header-title">
    <h2>Voucher Type</h2>
    <a ng-href='#vchType/0'  class="btn btn-primary"><i class="fa fa-plus" aria-hidden="true"></i> ADD</a>
</div>
<div kendo-grid k-options="vm.vouchertypeGridOption" k-data-source="vm.vouchertypeGridDataSource"></div>
<div kendo-window="vm.modal" k-visible="false" k-modal="true">
    Are you sure you want to delete: {{vm.voucherTypeName}}
    <button ng-click="vm.deleteData(vm.vOUCHERTYPEID)">Yes</button>
    <button ng-click="vm.closeModal()">No</button>
</div>
