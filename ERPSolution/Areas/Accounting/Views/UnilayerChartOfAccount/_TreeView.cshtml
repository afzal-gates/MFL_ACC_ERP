
<style>

    div.k-treeview {
        overflow: visible;
    }

</style>

<div class="col-md-6">
    <div class="portlet box blue-dark">
        <div class="portlet-title">
            <div class="caption">
               Chart Of Accounts
            </div>
        </div>
        <div class="portlet-body">
            <input type="text" style="margin-bottom: 10px;width:100%" placeholder="Search Items" ng-keyup="vm.searchKeyUp($event)" />

            <div kendo-tree-view k-data-source="vm.treeData"
                 k-on-change="selectedItem = dataItem">
                <span k-template>
                    <text ng-click='vm.click(dataItem)'>{{dataItem.text}} </text>
                </span>
            </div>

        </div>

    </div>
</div>
    <div class="col-md-6">

        @Html.Partial("~/Areas/Accounting/Views/UnilayerChartOfAccount/_Create.cshtml")

    </div>
