<div class="content">
    <div class="panel">
        <div class="header-title">
            <h2>Cost Center</h2>
            <div class="action-wrapper">
                <input type="text" ng-model="vm.searchText" placeholder="Search Item.." />
                <a ng-href='#costCenter/0' class="btn btn-primary"><i class="fa fa-plus" aria-hidden="true"></i> ADD</a>
            </div>
        </div>
        <div class="table-wrapper table-responsive">
            <div kendo-grid k-options="vm.costCenterGridOption" k-data-source="vm.costCenterGridDataSource"></div>
        </div>
    </div>
</div>
<div kendo-window="vm.modal" k-visible="false" k-modal="true">
    Are you sure you want to delete: {{vm.COST_CENTER_NAME}}
    <button ng-click="vm.deleteCostCenter(vm.COST_CENTER_ID)">Yes</button>
    <button ng-click="vm.closeModal()">No</button>
</div>


