@{
    Layout = null;
}


<h1>Control Ledger Report</h1>
<div class="portlet box blue-dark">
    <div class="portlet-title">
        <div class="caption">
            Ledger Report
        </div>
    </div>
    <div class="portlet-body">
        <form class="form-horizontal form-body" name="vm.form">
            <div class="row">
                <div class="col-sm-12">
                    <table class="table">
                        <tr>
                            <td>
                                From Date
                            </td>
                            <td>
                                <input kendo-date-picker ng-model="vm.fromdate" k-format="'dd-MMM-yyyy'" name="fromdate" required />
                            </td>

                            <td>
                                To Date
                            </td>
                            <td>
                                <input kendo-date-picker ng-model="vm.todate" k-format="'dd-MMM-yyyy'" name="todate" required />
                            </td>
                            <td>
                                <div class="btn-group">
                                    <button class="btn btn btn-danger dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        Export
                                    </button>
                                    <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                        <button ng-click="vm.showReport(1)" ng-disabled="vm.form.$invalid" class="btn">Pdf</button>
                                        <button ng-click="vm.showReport(3)" ng-disabled="vm.form.$invalid" class="btn">Excel</button>
                                    </div>
                                </div>
                            </td>
                        </tr>
              
                    </table>
                </div>
            </div>
        </form>
    </div>
</div>
<div class="portlet-body">
    <div kendo-tree-view k-data-source="vm.treeData"
         k-on-change="selectedItem = dataItem">
        <span k-template>
            <text ng-click='vm.selectMainClass(dataItem)'>{{dataItem.text}} </text>
        </span>
    </div>
</div>
