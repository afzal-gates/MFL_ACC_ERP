@{
    ViewBag.Title = "Voucher Posting";
}
<style>
    body {
        font-size: 12px !important;
    }
    .pr-zero {
        padding-right: 0;
    }
    .pl-zero {
        padding-left: 0;
    }
     .dropdown-header {
         background: #566170;
         color: #ffffff;
         font-size: 1.2em;
         padding: 0;
     }
    label {
        font-size: small;
    }
    .form-horizontal .control-label {
        text-align: left;
    }
        .dropdown-header > span; {
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
        box-sizing: border-box;
        text-align: left;
        display: inline-block;
        padding: 2px 10px;
    }

    .dropdown-header > span:first-child {
        width: 22%;
        border-right: 1px solid #fff;
    }
    .dropdown-header > span:last-child {
        width: 80%;
    }

    .selected-value {
        float: left;
        width: 20px;
        margin: 0 4px;
    }

    #customers-list .k-item > span {
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
        box-sizing: border-box;
        display: inline-block;
        border-style: solid;
        border-width: 0 0 1px 1px;
        vertical-align: top;
        min-height: 95px;
        width: 79%;
        padding: .6em 0 0 .6em;
    }

    #customers-list .k-item > span:first-child {
        width: 77px;
        border-left-width: 0;
        padding: .6em 0 0 0;
    }

    #customers-list img {
        -moz-box-shadow: 0 0 2px rgba(0,0,0,.4);
        -webkit-box-shadow: 0 0 2px rgba(0,0,0,.4);
        box-shadow: 0 0 2px rgba(0,0,0,.4);
        width: 70px;
        height: 70px;
    }

    /*#customers-list h3 {
        font-size: 1.6em;
        margin: 0;
        padding: 0;
    }*/

    #customers-list p {
        margin: 0;
        padding: 0;
    }
    .k-list {
        border: 1px solid #ddd;
    }
    .k-list-container {
        width: 96% !important;
    }
    .k-item {
        border-bottom: 1px solid #ddd;
    }
    .k-item .k-state-default:first-child {
        padding-left: 5px;
        float: left;
        width: 20.8%;
        border-right: 1px solid #aaa;
    }
    .k-item .k-state-default:last-child {
        
    }
    .k-item .k-state-default:last-child p {
        margin-bottom: 0;
    }

    .table thead {
        background: #bbb;
    }

    .table > tbody > tr > td {
        border: 1px solid #ccc;
    }
    .search-box {
        margin-bottom: 10px;
    }

    .account-wrapper::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 60.1%;
        height: 1px;
        background: #697e96;
    }
    .btn {
        border-radius: 2px;
    }
</style>
<div class="portlet-body" data-ui-view="voucher-masters"></div>



