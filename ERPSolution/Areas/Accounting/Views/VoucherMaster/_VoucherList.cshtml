@{
    Layout = null;
}

<style>
    .k-list-container {
        width: 632px;
    }
</style>

<div class="content">
    <div class="row">
        <div class="col-sm-4">
            @Html.Partial("~/Areas/Accounting/Views/VoucherMaster/_Edit.cshtml")
        </div>
        <div class="col-sm-8">
            <div class="panel">
                <div class="panel-body" style="padding: 0;">
                    <div class="search-box">
                        <input type="text" ng-model="vm.searchRefNo" maxlength="64" placeholder="Ref No." ng-keypress="$event.keyCode == 13 && vm.search()" />

                        <input type="text" ng-model="vm.searchVhcNo" maxlength="64" placeholder="Voucher No" ng-keypress="$event.keyCode == 13 && vm.search()" />
                        <input kendo-date-picker ng-model="vm.searchDate" k-format="'dd-MMM-yyyy'" placeholder="Voucher Date" ng-keypress="$event.keyCode == 13 && vm.search()" />
                        <button type="submit" ng-click="vm.search()"><i class="fa fa-search"></i></button>
                      
                    </div>
                    <div class="table-wrapper table-responsive" style="font-size: 10px;">
                        <div kendo-grid k-options="vm.voucherGridOption" k-data-source="vm.voucherGridDataSource"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="portlet box blue-dark account-wrapper" style="position: relative;border-radius: 0;">
        <div class="portlet-body" style="border-radius: 0px;">
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <input kendo-auto-complete k-placeholder="'search account head...'" ng-model="vm.keyText" k-ng-model="selectedItem"
                               ng-keypress="$event.keyCode == 13 && vm.moveTo('Narration')"
                               id="acc_head" k-options="vm.options" k-ng-delay="vm.options" class="form-control" style="width: 100%; background:#00ffff" />
                    </div>

                </div>
                <div class="col-sm-2" ng-show="vm.isBillVisisbile">
                    <div class="form-group k-content">
                        <button class="k-button btn-danger" ng-click="vm.showPandingBills()">Select Bill</button>
                    </div>
                </div>
                <div class="col-sm-2" ng-show="vm.isBillVisisbile">
                    <div class="form-group">
                        <input type="text" readonly="readonly" id="BILL_NO" placeholder="BILL NO" ng-model="vm.ACC_VOUCHER_DETAIL.BILL_NO" class="form-control" style="width: 100%;" />
                    </div>

                </div>
                <div class="col-sm-2" ng-show="vm.isBillVisisbile">
                    <div class="form-group">

                        <input type="text" readonly="readonly"  placeholder="BILL AMOUNT" ng-model="vm.BILL_AMNT" class="form-control" style="width: 100%;" />
                    </div>

                </div>
                <div class="col-sm-4" ng-show="!vm.isBillVisisbile">
                    <div class="form-group">
                        <input type="text" id="BILL_NO_NEW" placeholder="BILL  NO" ng-model="vm.ACC_VOUCHER_DETAIL.BILL_NO" class="form-control" style="width: 100%;" />
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-sm-3">
                    <div class="form-group">
                        <label class="control-label">Note</label>
                        <input type="text" id="Narration" ng-keypress="$event.keyCode == 13 && vm.moveTo('COST_CENTER_ID')" placeholder="Note" ng-model="vm.ACC_VOUCHER_DETAIL.DESCRIPTION" class="form-control" style="width: 100%;" />
                    </div>
                </div>
                <div class="col-sm-2">
                    <div class="form-group">
                        <label class="control-label">Cost Center</label>
                        <input  name="COST_CENTER_ID" id="COST_CENTER_ID" kendo-auto-complete k-options="vm.costCenterOptions" k-ng-model="selectedCostCenter" ng-model="vm.COST_CENTER_NAME" ng-keypress="$event.keyCode == 13 && vm.moveTo('CURRENCY_ID')" class="form-control" style="width: 100%;background:#00ffff" />
                    </div>
                </div>

                <div class="col-sm-1">
                    <div class="form-group">
                        <label class="control-label">Currency</label>
                        <select name="CURRENCY_ID" id="CURRENCY_ID" ng-change="vm.moveToRate('EXCHANGE_RATE')" ng-keypress="$event.keyCode == 13 && vm.moveToRate('EXCHANGE_RATE')" class="form-control" ng-model="vm.ACC_VOUCHER_DETAIL.CURRENCY_ID" ng-options="option.CURRENCY_ID as option.FORMAL_NAME for option in vm.currencies"></select>
                    </div>
                </div>
                <div class="col-sm-1">
                    <div class="form-group">
                        <label class="control-label">RATE({{vm.symbol}})</label>
                        <input type="text" class="form-control" ng-model="vm.ACC_VOUCHER_DETAIL.EXCHANGE_RATE" name="EXCHANGE_RATE" id="EXCHANGE_RATE" ng-keypress="$event.keyCode == 13 && vm.moveAndConvert('BDT_VALUE')" />
                    </div>
                </div>
                <div class="col-sm-1">
                    <div class="form-group">
                        <label class="control-label">VALUE</label>
                        <input type="text" class="form-control" ng-model="vm.BDT_VALUE" name="BDT_VALUE" id="BDT_VALUE" placeholder="BDT" ng-keypress="$event.keyCode == 13 && vm.moveTo('DR_AMT')" />
                    </div>
                </div>
                <div class="col-sm-2">
                    <div class="form-group">
                        <label class="control-label">DR</label>
                        <input type="text" class="form-control" ng-model="vm.ACC_VOUCHER_DETAIL.DR_AMT" name="DR_AMT" id="DR_AMT" ng-keypress="$event.keyCode == 13 && vm.saveDrTemVoucherDetail()" />
                    </div>
                </div>
                <div class="col-sm-2">
                    <div class="form-group">
                        <label class="control-label">CR</label>
                        <input type="text" class="form-control" id="CR_AMT" ng-model="vm.ACC_VOUCHER_DETAIL.CR_AMT" name="CR_AMT" ng-keypress="$event.keyCode == 13 && vm.saveCrTemVoucherDetail()" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="panel">
                        <div class="panel-body" style="padding:0;">
                            <div class="table-wrapper table-responsive" style="font-size:10px;">
                                <div kendo-grid k-options="vm.voucherTemDetailGridOption" k-data-source="vm.voucherTemDetailGridDataSource"  k-on-change="vm.onSelectionForNarration(kendoEvent)"></div>
                            </div>
                        </div>
                        <div class="panel-body" style="padding:0; margin-top:10px;">
                            <div class="table-wrapper table-responsive" style="font-size:10px;">
                                <div class="control-label col-sm-1 pr-zero">
                                    <label class="control-label">Narration</label>
                                    <button ng-click="vm.getLastNarration()"><i class="fa fa-filter"></i></button>
                                </div>
                                <div class="control-label col-sm-9 pr-zero">
                                    <textarea class="form-control" name="DESCRIPTION" ng-model="vm.voucher.DESCRIPTION" rows="1"></textarea>
                                </div>
                              
                                <div class="control-label col-sm-2 pr-zero">
                                    <input type="button" class="btn btn-warning" ng-click="vm.createNew()" value="New" />
                                    <input type="button" class="btn btn-primary" ng-click="vm.save()" id="btnSave" ng-disabled="!vm.IsEqualAmt" value="{{vm.btnText}}" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<div kendo-window="vm.billModal" k-modal="true" k-title="'pending bill voucher summary'"
     k-width="1000" k-height="400" k-visible="false" k-position="{ top: 100, left: 300 }">
    <div class="row">
        <div  class="portlet-body">
            <table class="table table-condensed">
                <tr>
                    <td>
                        <input kendo-date-picker ng-model="vm.fromdate" class="form-control" k-format="'dd-MMM-yyyy'" required />
                    </td>
                    <td>
                        <input kendo-date-picker ng-model="vm.todate" class="form-control" k-format="'dd-MMM-yyyy'" required />
                    </td>
                    <td>
                        <button type="submit" ng-click="vm.filterPendingBills()"><i class="fa fa-search"></i></button>
                    </td>
                    <td>
                        <input type="button" ng-click="vm.showPaidBillReports(1)" class="btn btn-danger" value="Paid Bill" />
                    </td>
                    <td>
                        <input type="button" ng-click="vm.showPandingBillReports(3)" class="btn btn-danger" value="Pending Bill" />

                    </td>
                    @*<td>
                        <input type="button" ng-click="vm.GetDuplicateBillPaymentReport(3)" class="btn btn-danger" value="All Duplicate Bill Payment" />
                    </td>*@
                </tr>
            </table>
        </div>
    
       
        <div style="margin-left:100px;">
  
  
          
        </div>
        <div class="table-wrapper table-responsive" style="font-size: 10px;">
            <div k-filterable="true" k-on-change="vm.onSelection(kendoEvent)" k-selectable="true" kendo-grid k-options="vm.billVoucherGridOption" k-data-source="vm.billVoucherGridDataSource"></div>
        </div>
    </div>
</div>
