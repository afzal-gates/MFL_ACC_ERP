<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core is included via the Web SDK -->

    <!-- Newtonsoft.Json for JSON serialization (upgraded from 6.0.8) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- SignalR for real-time communication -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.1.0" />

    <!-- Hangfire for background jobs -->
    <PackageReference Include="Hangfire.Core" Version="1.8.14" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.14" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />

    <!-- Dependency Injection - Use built-in DI or keep Ninject -->
    <!-- Option 1: Built-in DI (recommended) - no package needed -->
    <!-- Option 2: Keep Ninject -->
    <PackageReference Include="Ninject" Version="4.0.0" />
    <PackageReference Include="Ninject.Web.Common" Version="4.0.0" />

    <!-- PDF Generation (WkHtmlToPdf replacement for .NET Core) -->
    <PackageReference Include="DinkToPdf" Version="1.0.8" />

    <!-- FluentScheduler for task scheduling -->
    <PackageReference Include="FluentScheduler" Version="5.5.1" />

    <!-- RazorEngine (if still needed) -->
    <PackageReference Include="RazorEngine.NetCore" Version="3.1.0" />

    <!-- Email handling (Postal replacement) -->
    <PackageReference Include="MailKit" Version="4.7.1" />

    <!-- CORS support -->
    <PackageReference Include="Microsoft.AspNetCore.Cors" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project references -->
    <ProjectReference Include="..\ERP.BLL\ERP.BLL.csproj" />
    <ProjectReference Include="..\ERP.Core\ERP.Core.csproj" />
    <ProjectReference Include="..\ERP.DAL\ERP.DAL.csproj" />
    <ProjectReference Include="..\ERP.Data\ERP.Data.csproj" />
    <ProjectReference Include="..\ERP.Model\ERP.Model.csproj" />
    <ProjectReference Include="..\ERP.Shared\ERP.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Static files (AngularJS, jQuery, Bootstrap, etc.) -->
    <Content Include="Content\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Scripts\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
